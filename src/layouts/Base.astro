+---------------+------------------------------+-------------------+`
        ];

        const mFrames = [
`+-------------------------------------+
|  *     .      .--.      .      *    |
|     *        (    )        *     .  |
+-------------------------------------+
|  +-----------------------+   )  )   |
|  | > thoughts.txt        |  (  (    |
|  | --------------------- | .------. |
|  | writing at 2:00 am..._| |      |_|
|  +-----------------------+ |______|/|
|     [ open journal ]      [ coffee ]|
+-------------------------------------+`,

`+-------------------------------------+
|     *        .--.      *        .   |
|  .     *    (    )        .   *     |
+-------------------------------------+
|  +-----------------------+  (  (    |
|  | > thoughts.txt        |   )  )   |
|  | --------------------- | .------. |
|  | writing at 2:00 am..._| |      |_|
|  +-----------------------+ |______|/|
|     [ open journal ]      [ coffee ]|
+-------------------------------------+`,

`+-------------------------------------+
|  .     *      .--.        *     .   |
|     .        (    )    *        .   |
+-------------------------------------+
|  +-----------------------+   )  (   |
|  | > thoughts.txt        |  (  )    |
|  | --------------------- | .------. |
|  | writing at 2:00 am... | |      |_|
|  +-----------------------+ |______|/|
|     [ open journal ]      [ coffee ]|
+-------------------------------------+`,

`+-------------------------------------+
|     .        .--.    .        *     |
|  *     .    (    )      *        .  |
+-------------------------------------+
|  +-----------------------+  (  )    |
|  | > thoughts.txt        |   )  (   |
|  | --------------------- | .------. |
|  | writing at 2:00 am... | |      |_|
|  +-----------------------+ |______|/|
|     [ open journal ]      [ coffee ]|
+-------------------------------------+`
        ];

        let fIndex = 0;
        let animTimer = null;

        function runLoop(speed) {
          if (animTimer) clearInterval(animTimer);
          animTimer = setInterval(() => {
            fIndex = (fIndex + 1) % dFrames.length;
            if (heroDesktop) heroDesktop.textContent = dFrames[fIndex];
            if (heroMobile) heroMobile.textContent = mFrames[fIndex];
          }, speed);
        }

        // Active animation (450ms per frame)
        runLoop(450);

        // Tactile interactive response on hover
        const artLink = document.querySelector('.ascii-art-link');
        if (artLink) {
          artLink.addEventListener('mouseenter', () => runLoop(200));
          artLink.addEventListener('mouseleave', () => runLoop(450));
        }
      })();
    </script>
  </body>
</html>
