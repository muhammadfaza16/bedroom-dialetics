---
import Base from './Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  readingTime: number;
}

const { post, readingTime } = Astro.props;
const { title, date, excerpt } = post.data;

const formattedDate = date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = sortedPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const hasBoth = prevPost && nextPost;
---

<Base title={title} description={excerpt}>
  <article>
    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="/">Home</a>
      <span class="arrow">▸</span>
      <a href="/">Writing</a>
      <span class="arrow">▸</span>
      <span class="current">Current Page</span>
    </nav>

    <header class="read-header">
      <h1 class="read-title">{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span class="meta-sep">/</span>
        <span>Read time: {readingTime} min</span>
      </div>
    </header>

    <div class="prose" id="articleBody">
      <slot />
    </div>

    <footer class="post-footer-nav">
      {(prevPost || nextPost) && (
        <nav class={`post-prev-next${hasBoth ? '' : ' single'}`} aria-label="Essay navigation">
          {prevPost && (
            <a href={`/posts/${prevPost.id}`} class="nav-link prev-link">
              <span class="nav-label">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-arrow" aria-hidden="true">
                  <path d="m12 19-7-7 7-7"/>
                  <path d="M19 12H5"/>
                </svg>
                <span>Previous</span>
              </span>
              <span class="nav-title">{prevPost.data.title}</span>
            </a>
          )}
          {nextPost && (
            <a href={`/posts/${nextPost.id}`} class={`nav-link next-link${!prevPost ? ' solo-next' : ''}`}>
              <span class="nav-label">
                <span>Next</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-arrow" aria-hidden="true">
                  <path d="M5 12h14"/>
                  <path d="m12 5 7 7-7 7"/>
                </svg>
              </span>
              <span class="nav-title">{nextPost.data.title}</span>
            </a>
          )}
        </nav>
      )}

      <div class="post-bottom-actions">
        <a href="/" class="back-link-bottom" aria-label="Back to Journal">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-arrow" aria-hidden="true">
            <path d="m12 19-7-7 7-7"/>
            <path d="M19 12H5"/>
          </svg>
          <span>Back to Journal</span>
        </a>
        <button id="scrollTopBtn" class="scroll-top-btn" type="button" aria-label="Back to top" onclick="window.scrollTo({ top: 0, behavior: 'smooth' });">
          <span>Back to top</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-arrow" aria-hidden="true">
            <path d="m5 12 7-7 7 7"/>
            <path d="M12 19V5"/>
          </svg>
        </button>
      </div>
    </footer>
  </article>
</Base>
